{
  "schema_version": 1,
  "version": "1.0.0",
  "name": "nextjs",
  "description": "nextjs application",
  "files": [
    {
      "src": "src/greeting.mjs.j2",
      "dest": "src/greeting.mjs"
    },
    {
      "src": "tests/greeting.test.mjs.j2",
      "dest": "tests/greeting.test.mjs"
    },
    {
      "src": ".gitignore.j2",
      "dest": ".gitignore"
    },
    {
      "src": "README.md.j2",
      "dest": "README.md"
    },
    {
      "src": ".nvmrc.j2",
      "dest": ".nvmrc"
    },
    {
      "src": ".npmrc.j2",
      "dest": ".npmrc"
    },
    {
      "src": "tsconfig.json.j2",
      "dest": "tsconfig.json"
    },
    {
      "src": "eslint.config.mjs.j2",
      "dest": "eslint.config.mjs"
    },
    {
      "src": ".dockerignore.j2",
      "dest": ".dockerignore"
    },
    {
      "src": "Dockerfile.j2",
      "dest": "Dockerfile"
    },
    {
      "src": "app/layout.tsx.j2",
      "dest": "app/layout.tsx"
    },
    {
      "src": "app/page.tsx.j2",
      "dest": "app/page.tsx"
    },
    {
      "src": "app/not-found.tsx.j2",
      "dest": "app/not-found.tsx"
    },
    {
      "src": "next.config.ts.j2",
      "dest": "next.config.ts"
    },
    {
      "src": "next-env.d.ts.j2",
      "dest": "next-env.d.ts"
    },
    {
      "src": "package.json.j2",
      "dest": "package.json"
    }
  ],
  "post_create": [
    {
      "argv": [
        "npm",
        "install"
      ]
    }
  ],
  "next_steps": [
    "npm install",
    "npm test",
    "npm run build"
  ]
}
