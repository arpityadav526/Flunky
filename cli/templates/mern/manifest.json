      "dest": ".gitignore"
    },
    {
      "src": "README.md.j2",
      "dest": "README.md"
    },
    {
      "src": ".nvmrc.j2",
      "dest": ".nvmrc"
    },
    {
      "src": ".npmrc.j2",
      "dest": ".npmrc"
    },
    {
      "src": "tsconfig.json.j2",
      "dest": "tsconfig.json"
    },
    {
      "src": "eslint.config.mjs.j2",
      "dest": "eslint.config.mjs"
