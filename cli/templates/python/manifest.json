{
  "schema_version": 1,
  "version": "1.0.0",
  "name": "python",
  "description": "python Python project",
  "files": [
    {
      "src": "pyproject.toml.j2",
      "dest": "pyproject.toml"
    },
    {
      "src": "src/__package_name__/__init__.py.j2",
      "dest": "src/{{ package_name }}/__init__.py"
    },
    {
      "src": "src/__package_name__/__main__.py.j2",
      "dest": "src/{{ package_name }}/__main__.py"
    },
    {
      "src": "main.py.j2",
      "dest": "main.py"
    },
    {
      "src": "README.md.j2",
      "dest": "README.md"
    },
    {
      "src": ".python-version.j2",
      "dest": ".python-version"
    },
    {
      "src": "pytest.ini.j2",
      "dest": "pytest.ini"
    },
    {
      "src": "ruff.toml.j2",
      "dest": "ruff.toml"
    },
    {
      "src": ".gitignore.j2",
      "dest": ".gitignore"
    },
    {
      "src": "tests/test_greeting.py.j2",
      "dest": "tests/test_greeting.py"
    },
    {
      "src": "Dockerfile.j2",
      "dest": "Dockerfile"
    },
    {
      "src": ".dockerignore.j2",
      "dest": ".dockerignore"
    }
  ],
  "post_create": [
    {
      "argv": [
        "uv",
        "sync",
        "--extra",
        "dev"
      ]
    }
  ],
  "next_steps": [
    "uv sync --extra dev",
    "uv run pytest",
    "uv run ruff check ."
  ]
}
