{
  "schema_version": 1,
  "version": "1.0.0",
  "name": "electron",
  "description": "electron application",
  "files": [
    {
      "src": "src/greeting.mjs.j2",
      "dest": "src/greeting.mjs"
    },
    {
      "src": "tests/greeting.test.mjs.j2",
      "dest": "tests/greeting.test.mjs"
    },
    {
      "src": ".gitignore.j2",
      "dest": ".gitignore"
    },
    {
      "src": "README.md.j2",
      "dest": "README.md"
    },
    {
      "src": ".nvmrc.j2",
      "dest": ".nvmrc"
    },
    {
      "src": ".npmrc.j2",
      "dest": ".npmrc"
    },
    {
      "src": "tsconfig.json.j2",
      "dest": "tsconfig.json"
    },
    {
      "src": "eslint.config.mjs.j2",
      "dest": "eslint.config.mjs"
    },
    {
      "src": ".dockerignore.j2",
      "dest": ".dockerignore"
    },
    {
      "src": "Dockerfile.j2",
      "dest": "Dockerfile"
    },
    {
      "src": "electron/main.cjs.j2",
      "dest": "electron/main.cjs"
    },
    {
      "src": "index.html.j2",
      "dest": "index.html"
    },
    {
      "src": "src/renderer.mjs.j2",
      "dest": "src/renderer.mjs"
    },
    {
      "src": "scripts/build.mjs.j2",
      "dest": "scripts/build.mjs"
    },
    {
      "src": "package.json.j2",
      "dest": "package.json"
    }
  ],
  "post_create": [
    {
      "argv": [
        "npm",
        "install"
      ]
    }
  ],
  "next_steps": [
    "npm install",
    "npm test",
    "npm run build"
  ]
}
