{
  "schema_version": 1,
  "version": "1.0.0",
  "name": "flutter",
  "description": "Flutter application with tested widget entry point",
  "files": [
    {
      "src": "pubspec.yaml.j2",
      "dest": "pubspec.yaml"
    },
    {
      "src": "lib/main.dart.j2",
      "dest": "lib/main.dart"
    },
    {
      "src": "test/widget_test.dart.j2",
      "dest": "test/widget_test.dart"
    },
    {
      "src": "analysis_options.yaml.j2",
      "dest": "analysis_options.yaml"
    },
    {
      "src": "README.md.j2",
      "dest": "README.md"
    },
    {
      "src": ".gitignore.j2",
      "dest": ".gitignore"
    }
  ],
  "post_create": [
    {
      "argv": [
        "flutter",
        "pub",
        "get"
      ]
    }
  ],
  "next_steps": [
    "flutter create --platforms=android,ios,web .",
    "flutter pub get",
    "flutter analyze",
    "flutter test"
  ]
}
